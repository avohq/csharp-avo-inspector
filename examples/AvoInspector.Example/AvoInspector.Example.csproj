<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Avo.Inspector.Example</RootNamespace>
    <AssemblyName>AvoInspector.Example</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Builds against this checkout, so the example always shows the SDK it ships with. -->
  <ItemGroup>
    <ProjectReference Include="../../src/AvoInspector/AvoInspector.csproj" />
  </ItemGroup>

</Project>
